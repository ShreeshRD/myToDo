#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

PID_FILE="$SCRIPT_DIR/.mcp.pid"
LOG_FILE="$SCRIPT_DIR/mcp.log"

get_pid() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "$pid"
      return 0
    fi
  fi

  local pids
  pids="$(pgrep -f "node src/server.js" 2>/dev/null || true)"
  if [ -n "$pids" ]; then
    echo "$pids" | head -n 1
    return 0
  fi

  return 1
}

start() {
  local pid
  if pid="$(get_pid)"; then
    echo "MCP server is already running (PID: $pid)."
    return 0
  fi

  rm -f "$PID_FILE"
  echo "Starting MCP server..."
  setsid env TODO_API_URL="${TODO_API_URL:-http://127.0.0.1:8000}" npm start </dev/null > "$LOG_FILE" 2>&1 &

  sleep 1
  if pid="$(get_pid)"; then
    echo "$pid" > "$PID_FILE"
    echo "MCP server started successfully (PID: $pid)."
    echo "Logs: $LOG_FILE"
  else
    echo "Failed to start MCP server. Check logs: $LOG_FILE"
    rm -f "$PID_FILE"
    exit 1
  fi
}

stop() {
  local pid
  if pid="$(get_pid)"; then
    echo "Stopping MCP server (PID: $pid)..."
    kill "$pid" 2>/dev/null || true
    pkill -f "node src/server.js" 2>/dev/null || true

    local count=0
    while kill -0 "$pid" 2>/dev/null && [ $count -lt 5 ]; do
      sleep 1
      count=$((count + 1))
    done

    if kill -0 "$pid" 2>/dev/null; then
      echo "Process still alive; forcing shutdown..."
      kill -9 "$pid" 2>/dev/null || true
      pkill -9 -f "node src/server.js" 2>/dev/null || true
    fi

    rm -f "$PID_FILE"
    echo "MCP server stopped."
  else
    echo "MCP server is not running."
    rm -f "$PID_FILE"
  fi
}

status() {
  local pid
  if pid="$(get_pid)"; then
    echo "MCP server is running (PID: $pid)."
    if command -v curl >/dev/null 2>&1; then
      local health
      health="$(curl -s -m 2 http://127.0.0.1:8765/health 2>/dev/null || true)"
      if [ -n "$health" ]; then
        echo "Health check: $health"
      fi
    fi
  else
    echo "MCP server is not running."
  fi
}

ask() {
  if [ $# -eq 0 ]; then
    echo "Error: Please provide a prompt after 'ask'."
    echo "Example: $0 ask How many open tasks do I have today?"
    exit 1
  fi

  local prompt="$*"
  node scripts/agent.mjs "$prompt"
}

case "$1" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  status)
    status
    ;;
  ask)
    shift
    ask "$@"
    ;;
  *)
    echo "Usage: $0 {start|stop|status|ask <prompt>}"
    exit 1
    ;;
esac
